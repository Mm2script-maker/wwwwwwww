local recent = {}

local function renderRecent()
	for _, c in ipairs(recentRow:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	recentRow.Visible = (#recent > 0)
	for i, m in ipairs(recent) do
		local col = rarityColor(tostring(m.info.Rarity or "?"))
		local chip = mk("TextButton", {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = THEME.Panel,
			Text = m.name,
			TextColor3 = readable(col),
			TextSize = 11,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			LayoutOrder = i,
		}, recentRow)
		corner(chip, 8)
		pad(chip, 11, 0)
		local st = stroke(chip, col, 1, 0.65)
		chip.MouseEnter:Connect(function()
			tween(chip, {BackgroundColor3 = THEME.Panel2})
			tween(st, {Transparency = 0.25})
		end)
		chip.MouseLeave:Connect(function()
			tween(chip, {BackgroundColor3 = THEME.Panel})
			tween(st, {Transparency = 0.65})
		end)
		chip.MouseButton1Click:Connect(function()
			nameBox.Text = m.name
			showMatch(m)
		end)
	end
end

local function pushRecent(m)
	for i, r in ipairs(recent) do
		if r.id == m.id and r.cat == m.cat then table.remove(recent, i) break end
	end
	table.insert(recent, 1, m)
	while #recent > 4 do table.remove(recent) end
	renderRecent()
end

showMatch = function(m)
	match = m
	if not m then
		matchIcon.Image = ""
		matchName.Text = (nameBox.Text == "") and "type a weapon name" or "no weapon by that name"
		matchName.TextColor3 = THEME.TextDim
		matchChip.Visible = false
		ownedLabel.Text = ""
		matchWash.BackgroundColor3 = THEME.Panel
		tween(matchStroke, {Color = THEME.Stroke, Transparency = 0.45})
		paintButton(false)
		return
	end
	local rarity = tostring(m.info.Rarity or "?")
	local col = rarityColor(rarity)
	local n = ownedCount(m.cat, m.id)
	matchIcon.Image = normalizeImage(m.info.Image)
	matchName.Text = m.name
	matchName.TextColor3 = THEME.Text
	-- spell out CHROMA: the plain and chroma weapons share a display name,
	-- so without this you can't tell which one the box resolved to
	matchChip.Text = rarity:upper() .. "  ·  " .. tostring(m.info.ItemType or m.cat):upper()
		.. (isChroma(m.id, m.info) and "  ·  CHROMA" or "")
	matchChip.TextColor3 = readable(col)
	matchChip.BackgroundColor3 = col
	matchChip.Visible = true
	matchWash.BackgroundColor3 = col
	ownedLabel.Text = (n > 0) and ("x" .. n) or "none"
	ownedLabel.TextColor3 = (n > 0) and THEME.Accent or THEME.TextDim
	tween(matchStroke, {Color = col, Transparency = 0.15})
	paintButton(true)
end

