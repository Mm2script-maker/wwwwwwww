--==================================================================--
--  YOMOGI DUPE                            Made By Yomogi Scripts
--  Type a weapon name, hit DUPE ITEM, get another copy. Each click is
--  one copy; the card above the button shows exactly which weapon the
--  name matched and how many you hold, so you never dupe the wrong one.
--
--  The click runs a ~5s progress sweep with a live log before the copy
--  lands. That is presentation, not work — see the FAKE table below to
--  retime it or switch it off. The copy itself is instant either way.
--
--  Y arms a second display trick, shown only as an unlabelled dot beside
--  the close button: put something in your own offer and five seconds
--  later the other player's panel answers it, as if they had just added
--  something back, with the most valuable weapons this game has. Accept
--  and each one raises the game's own received-item card. See FAKE_OFFER
--  and RICH. Your screen only.
--
--  HOW IT WORKS / WHAT IT IS NOT:
--  MM2 keeps the client's inventory in a ReplicatedStorage module table
--  (Modules.ProfileData). This writes to that table and fires the
--  game's own InventoryDataChanged signal, exactly like the spawner
--  does when it spawns a weapon. The copies are CLIENT-SIDE: they show
--  in your inventory, your trade window and anything you record — the
--  server never hears about them, and the other player's client draws
--  their own trade view from server data. Rejoining, or
--  _G.YomogiDupeUndo(), puts everything back.
--==================================================================--
local Players          = game:GetService("Players")
local RS               = game:GetService("ReplicatedStorage")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local LocalPlayer      = Players.LocalPlayer

-- inventory cards render the count as "xN"; past this it is just noise
local MAX_PER_ITEM = 999

--------------------------------------------------------------------
-- Presentation. The dupe itself is instant — this is the run that
-- plays on screen while it happens, so a click looks like work instead
-- of a number jumping. Nothing here changes what actually gets written.
--
--   Enabled     false = old instant behaviour
--   Min/Max     seconds per run, picked fresh each click. A run that is
--               the exact same length every time is the tell.
--   HiccupOdds  1-in-N runs stall near the end with a backoff/retry.
--               A method that never once hiccups looks scripted.
--------------------------------------------------------------------
local FAKE = {
	Enabled    = true,
	MinSeconds = 4.2,
	MaxSeconds = 5.9,
	HiccupOdds = 7,
}

-- made up once per injection so the log has a stable "server" to name
local NODE = ("us-east-%d%s"):format(math.random(1, 9), string.char(math.random(97, 102)))

--------------------------------------------------------------------
-- Clean up a previous run
--------------------------------------------------------------------
local function guiRoots()
	-- built with table.insert, NOT a literal: without gethui the first
	-- slot would be nil and ipairs stops dead at the first nil
	local roots = {}
	if gethui then
		local ok, h = pcall(gethui)
		if ok and h then table.insert(roots, h) end
	end
	local okCG, cg = pcall(function() return game:GetService("CoreGui") end)
	if okCG and cg then table.insert(roots, cg) end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then table.insert(roots, pg) end
	return roots
end

if _G.YomogiDupeCleanup then pcall(_G.YomogiDupeCleanup) end
if _G.YurevixDupeCleanup then pcall(_G.YurevixDupeCleanup) end -- older build
for _, container in ipairs(guiRoots()) do
	for _, gname in ipairs({"YomogiDupeGui", "YurevixDupeGui"}) do
		local old = container:FindFirstChild(gname)
		if old then pcall(function() old:Destroy() end) end
	end
end

--------------------------------------------------------------------
-- Game modules. require() is wrapped per-module so one missing module
-- can't kill the rest, with a getgc sweep for executors that can't
-- require a game ModuleScript at all.
--------------------------------------------------------------------
local function setIdentity(id)
	pcall(function()
		if setthreadidentity then setthreadidentity(id)
		elseif setidentity then setidentity(id)
		elseif setthreadcontext then setthreadcontext(id)
		end
	end)
end

local ProfileData, InventoryModule, ItemModule, Sync, ItemPopupService
do
	setIdentity(2)
	pcall(function() ProfileData      = require(RS.Modules.ProfileData) end)
	pcall(function() InventoryModule  = require(RS.Modules.InventoryModule) end)
	pcall(function() ItemModule       = require(RS.Modules.ItemModule) end)
	pcall(function() Sync             = require(RS.Database.Sync) end)
	pcall(function() ItemPopupService = require(RS.ClientServices.ItemPopupService) end)
	setIdentity(8)
	if (not ProfileData or not Sync) and getgc then
		for _, v in ipairs(getgc(true)) do
			if type(v) == "table" then
				if not Sync and type(rawget(v, "Item")) == "table" and type(rawget(v, "Rarities")) == "table" then
					Sync = v
				end
				if not ProfileData and type(rawget(v, "Weapons")) == "table"
					and type(rawget(rawget(v, "Weapons"), "Owned")) == "table" then
					ProfileData = v
				end
			end
		end
	end
end

local READY = (ProfileData ~= nil and Sync ~= nil)

--------------------------------------------------------------------
-- Item lookup
--------------------------------------------------------------------
-- Where to read an item's data from, per inventory category. Weapons
-- fall back to Sync.Item — that is the table the spawner reads.
local INFO_KEYS = {
	Weapons = {"Weapons", "Item"},
	Pets    = {"Pets", "Pet", "Item"},
}

local function itemInfo(cat, id)
	if not Sync then return nil end
	for _, key in ipairs(INFO_KEYS[cat] or {"Item"}) do
		local t = rawget(Sync, key)
		if type(t) == "table" and type(t[id]) == "table" then return t[id] end
	end
	return nil
end

local function rarityColor(name)
	local r = Sync and Sync.Rarities and Sync.Rarities[name]
	if r and r.Hex then
		local ok, c = pcall(Color3.fromHex, r.Hex)
		if ok then return c end
	end
	return Color3.fromRGB(122, 122, 128)
end

-- MM2's rarity colours are picked to sit on ITS dark UI — several (the
-- cyans, the yellows) are near-white and vanish as text on a light one.
-- Scale anything above the luminance ceiling down until it reads. Fills,
-- washes and strokes still use the raw colour; only text goes through this.
local function readable(c)
	local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	if lum <= 0.52 then return c end
	local f = 0.52 / lum
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

-- MM2's old thumbnail URLs don't render in ImageLabels; convert them to
-- rbxthumb so the match card actually shows the weapon.
local function normalizeImage(img)
	img = tostring(img or "")
	if img:find("Asset%.ashx") then
		local id = img:match("assetId=(%d+)")
		if id then return "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150" end
	end
	return img
end

-- Tables to search, in priority order. Sync.Weapons is the authoritative
-- weapon list when the game has one; Sync.Item is the spawner's source.
local SOURCES = {}
if Sync then
	for _, spec in ipairs({{"Weapons", "Weapons"}, {"Weapons", "Item"}, {"Pets", "Pets"}}) do
		local t = rawget(Sync, spec[2])
		if type(t) == "table" then table.insert(SOURCES, {cat = spec[1], tbl = t}) end
	end
end

local function usable(cat, info)
	if type(info) ~= "table" then return false end
	if cat == "Weapons" and info.ItemType then
		return info.ItemType == "Knife" or info.ItemType == "Gun"
	end
	return true
end

local function isChroma(id, info)
	return (info and info.Chroma == true) or tostring(id):lower():find("chroma", 1, true) ~= nil
end

-- Exact id / exact name first, then the shortest substring match, so
-- "snow" lands on Snowcannon rather than something longer that happens
-- to contain it.
--
-- The chroma tie-break matters: a chroma variant carries the PLAIN name
-- in the DB ("SnowcannonChroma".ItemName == "Snowcannon"), so an exact
-- name match hits two entries and pairs() order decided which one you
-- got. Typing "snowcannon" now gives the plain weapon and "chroma
-- snowcannon" gives the chroma one.
local function findItem(query)
	if not Sync then return nil end
	local q = tostring(query):lower():gsub("^%s+", ""):gsub("%s+$", "")
	if q == "" then return nil end
	local wantChroma = q:find("chroma", 1, true) ~= nil
	local best, bestScore

	local function consider(id, info, cat, name, score)
		if isChroma(id, info) == wantChroma then score += 4 end
		if not best or score > bestScore then
			best, bestScore = {id = id, cat = cat, info = info, name = name}, score
		end
	end

	for _, src in ipairs(SOURCES) do
		for id, info in pairs(src.tbl) do
			if usable(src.cat, info) then
				local name = tostring(info.ItemName or id)
				if tostring(id):lower() == q then
					consider(id, info, src.cat, name, 20)
				elseif name:lower() == q then
					consider(id, info, src.cat, name, 10)
				end
			end
		end
	end
	if best then return best end

	for _, src in ipairs(SOURCES) do
		for id, info in pairs(src.tbl) do
			if usable(src.cat, info) then
				local name = tostring(info.ItemName or id)
				if name:lower():find(q, 1, true) or tostring(id):lower():find(q, 1, true) then
					-- shorter name = closer match; keep it above the chroma bonus
					consider(id, info, src.cat, name, 100 - math.min(#name, 60))
				end
			end
		end
	end
	if best then return best end

	-- Word pass, for typed-out names like "chroma snowcannon" that exist
	-- as no single substring anywhere: every word has to turn up in the
	-- name, the id or the rarity.
	local words = {}
	for w in q:gmatch("%S+") do words[#words + 1] = w end
	if #words > 1 then
		for _, src in ipairs(SOURCES) do
			for id, info in pairs(src.tbl) do
				if usable(src.cat, info) then
					local name = tostring(info.ItemName or id)
					local hay = (name .. " " .. tostring(id) .. " " .. tostring(info.Rarity or "")):lower()
					local all = true
					for _, w in ipairs(words) do
						if not hay:find(w, 1, true) then all = false break end
					end
					if all then consider(id, info, src.cat, name, 100 - math.min(#name, 60)) end
				end
			end
		end
	end
	return best
end

--------------------------------------------------------------------
-- Owned counts
--
-- ProfileData Owned tables come in two shapes in the wild:
--   map   -> Owned["Gingerscope"] = 3
--   array -> Owned[1] = "Gingerscope"
-- Both are handled everywhere below.
--------------------------------------------------------------------
local Added = {} -- [cat][id] = copies THIS script added, for undo

local function ownedTable(cat)
	local node = ProfileData and ProfileData[cat]
	local owned = node and node.Owned
	return (type(owned) == "table") and owned or nil
end

local function ownedCount(cat, id)
	local owned = ownedTable(cat)
	if not owned then return 0, "map" end
	if type(owned[id]) == "number" then return owned[id], "map" end
	local n = 0
	for k, v in pairs(owned) do
		if type(k) == "number" and v == id then n += 1 end
	end
	if n > 0 then return n, "array" end
	return 0, "map"
end

-- total items held in a category. Real number, and the log reads far
-- better quoting your actual inventory size than a made-up one.
local function countEntries(cat)
	local owned = ownedTable(cat)
	if not owned then return 0 end
	local n = 0
	for _, v in pairs(owned) do
		n += (type(v) == "number") and v or 1
	end
	return n
end

--------------------------------------------------------------------
-- Trade engine  (ported from the spawner's trade module)
--
-- MM2 builds the trade list once, when the trade opens, straight from
-- ProfileData — so copies made afterwards are invisible to it, and
-- rebuilding the list replaces the frames, which drops the click
-- handlers the game put on them. That is why only one item could ever
-- be placed in the offer. So this owns the whole flow instead: rebuild
-- the list, wire the item clicks ourselves, render YOUR OFFER from our
-- own table, and drive the accept / confirm / cancel / decline buttons.
--
-- Your side only — nothing here writes into the other player's offer.
--------------------------------------------------------------------
local TRADE = {
	offer     = {},    -- [1..4] = {cat, id, amount}
	conns     = {},    -- per-trade connections, dropped on every rebuild
	slotConns = {},    -- [frame] = handler on an offered stack
	inv       = nil,   -- the inventory table GenerateInventory handed back
	state     = "Accept",
	accepted  = false,
	locked    = false,
	cooldown  = 0,
	cooling   = false,
	starting  = false,
	confirmAt = 0,
	searchConn = nil,
}

local updateTrade, renderOffer -- forward: they call each other

-- Fires whenever the contents of YOUR offer actually change. Assigned way
-- down in the their-offer section; nil until then, so updateTrade has to
-- nil-check it.
local onMyOfferChanged

-- Fires when you accept, so the items their side was showing can land in
-- your inventory with the game's own received-item popup. Assigned down in
-- the GUI section, where the log panel it writes to exists.
local onTradeAccepted

local function tradeGui()
	local tg = LocalPlayer.PlayerGui:FindFirstChild("TradeGUI")
	if tg and tg:FindFirstChild("Container") then return tg end
	return nil
end

local function dropConns()
	for _, c in ipairs(TRADE.conns) do pcall(function() c:Disconnect() end) end
	TRADE.conns = {}
end

local function offerIndex(cat, id)
	for i, s in ipairs(TRADE.offer) do
		if s.id == id and s.cat == cat then return i end
	end
	return nil
end

renderOffer = function()
	local tg = tradeGui()
	if not tg or not ItemModule then return end
	local cont = tg.Container.Trade.YourOffer.Container
	for i = 1, 4 do
		local f = cont:FindFirstChild("NewItem" .. i)
		local slot = TRADE.offer[i]
		if f and slot then
			local info = itemInfo(slot.cat, slot.id)
			if info then
				local data = {}
				for k, v in pairs(info) do data[k] = v end
				data.DataType, data.Amount = slot.cat, slot.amount
				data.ItemName, data.Name = slot.id, slot.id
				pcall(function() ItemModule.DisplayItem(f, data) end)
				f.Visible = true
				if TRADE.slotConns[f] then pcall(function() TRADE.slotConns[f]:Disconnect() end) end
				local btn = f:FindFirstChild("Container")
				btn = btn and btn:FindFirstChild("ActionButton")
				if btn then
					-- clicking a stack in your offer takes one copy back out
					TRADE.slotConns[f] = btn.MouseButton1Click:Connect(function()
						if TRADE.accepted or TRADE.locked then return end
						local idx = offerIndex(slot.cat, slot.id)
						if not idx then return end
						TRADE.offer[idx].amount -= 1
						if TRADE.offer[idx].amount <= 0 then table.remove(TRADE.offer, idx) end
						updateTrade()
					end)
				end
			end
		elseif f then
			f.Visible = false
		end
	end
end

-- mirror the game: an item sitting in your offer comes off the list count
local function updateTradeList()
	local inv = TRADE.inv
	if not inv or type(inv.Data) ~= "table" then return end
	for typeName, byType in pairs(inv.Data) do
		if type(byType) == "table" then
			for _, group in pairs(byType) do
				if type(group) == "table" then
					for itemId, node in pairs(group) do
						local frame = (type(node) == "table") and node.Frame or nil
						local amount = (type(node) == "table") and node.Amount or nil
						if frame and amount then
							for _, s in ipairs(TRADE.offer) do
								if s.id == itemId and s.cat == typeName then amount -= s.amount end
							end
							local lbl = frame:FindFirstChild("Container")
							lbl = lbl and lbl:FindFirstChild("Amount")
							if amount > 1 then
								if lbl then lbl.Text = "x" .. amount end
								frame.Visible = true
							elseif amount == 1 then
								if lbl then lbl.Text = "" end
								frame.Visible = true
							else
								frame.Visible = false
							end
						end
					end
				end
			end
		end
	end
end

local function resetCooldown(clear)
	local tg = tradeGui()
	local accept = tg and tg.Container.Trade.Actions.Accept
	local cd = accept and accept:FindFirstChild("Cooldown")
	if not cd then return end
	if clear then
		cd.Visible = false
		TRADE.cooldown, TRADE.cooling = 0, false
		return
	end
	cd.Visible = true
	TRADE.cooldown = 6
	pcall(function() cd.Title.Text = " Please wait (6) before accepting." end)
	if TRADE.cooling then return end
	TRADE.cooling = true
	task.spawn(function()
		repeat
			task.wait(1)
			TRADE.cooldown -= 1
			pcall(function() cd.Title.Text = (" Please wait (%d) before accepting."):format(TRADE.cooldown) end)
		until TRADE.cooldown <= 0
		TRADE.cooling = false
		pcall(function() cd.Visible = false end)
	end)
end

updateTrade = function()
	pcall(function()
		local tg = tradeGui()
		if not tg then return end
		renderOffer()
		updateTradeList()
		local A = tg.Container.Trade.Actions.Accept
		TRADE.state, TRADE.accepted = "Accept", false
		if A:FindFirstChild("Confirm") then A.Confirm.Visible = false end
		if A:FindFirstChild("Cancel") then A.Cancel.Visible = false end
		local yo = tg.Container.Trade.YourOffer
		if yo:FindFirstChild("Accepted") then yo.Accepted.Visible = false end
		local empty = (#TRADE.offer < 1)
		if A:FindFirstChild("AddItem") then A.AddItem.Visible = empty end
		resetCooldown(empty)
	end)
	-- outside the pcall: this still needs to run when there is no trade GUI
	-- yet, or the signature goes stale and the next real change looks like
	-- no change at all
	if onMyOfferChanged then pcall(onMyOfferChanged) end
end

-- one click on a weapon in the trade list = one copy into your offer
local function offerItem(cat, id)
	if TRADE.locked or TRADE.accepted then return false end
	local have = ownedCount(cat, id)
	if have <= 0 then return false end
	local idx = offerIndex(cat, id)
	local already = idx and TRADE.offer[idx].amount or 0
	if have - already <= 0 then return false end
	if idx then
		TRADE.offer[idx].amount += 1
	elseif #TRADE.offer < 4 then
		table.insert(TRADE.offer, {cat = cat, id = id, amount = 1})
	else
		return false -- all four slots are full
	end
	updateTrade()
	return true
end

-- accepting takes the offered copies out of your inventory, the way the
-- real thing would once the trade goes through
local function removeOwned(cat, id, amount)
	local owned = ownedTable(cat)
	if not owned then return end
	if type(owned[id]) == "number" then
		local left = owned[id] - amount
		if left > 0 then owned[id] = left else owned[id] = nil end
	else
		local dropped = 0
		for i = #owned, 1, -1 do
			if dropped >= amount then break end
			if owned[i] == id then
				table.remove(owned, i)
				dropped += 1
			end
		end
	end
	local addedCat = Added[cat]
	if addedCat and addedCat[id] then
		addedCat[id] = math.max(addedCat[id] - amount, 0)
		if addedCat[id] == 0 then addedCat[id] = nil end
	end
end

local function acceptTrade()
	if TRADE.locked then return end
	TRADE.locked = true
	task.wait(0.2)
	for _, s in ipairs(TRADE.offer) do
		pcall(removeOwned, s.cat, s.id, s.amount)
	end
	TRADE.offer = {}
	-- Before the window closes: closing it trips the Enabled handler, which
	-- clears their offer and drops the `live` flag this reads.
	if onTradeAccepted then pcall(onTradeAccepted) end
	pcall(function() tradeGui().Enabled = false end)
	TRADE.locked, TRADE.accepted, TRADE.state = false, false, "Accept"
	pcall(function() RS.Remotes.Inventory.InventoryDataChanged:Fire() end)
end

local function declineTrade()
	pcall(function() tradeGui().Enabled = false end)
	TRADE.offer = {}
	TRADE.locked, TRADE.accepted, TRADE.state = false, false, "Accept"
	dropConns()
end

local function setupConnections()
	local tg = tradeGui()
	local trade = tg and tg.Container:FindFirstChild("Trade")
	local actions = trade and trade:FindFirstChild("Actions")
	if not actions then return end
	dropConns()
	local inv = TRADE.inv
	if inv and type(inv.Data) == "table" then
		for typeName, byType in pairs(inv.Data) do
			if type(byType) == "table" then
				for _, group in pairs(byType) do
					if type(group) == "table" then
						for itemId, node in pairs(group) do
							local f = (type(node) == "table") and node.Frame or nil
							local btn = f and f:FindFirstChild("Container")
							btn = btn and btn:FindFirstChild("ActionButton")
							if btn then
								table.insert(TRADE.conns, btn.MouseButton1Click:Connect(function()
									offerItem(typeName, itemId)
								end))
							end
						end
					end
				end
			end
		end
	end
	local A = actions:FindFirstChild("Accept")
	if A then
		if A:FindFirstChild("ActionButton") then
			table.insert(TRADE.conns, A.ActionButton.MouseButton1Click:Connect(function()
				if TRADE.cooldown <= 0 and TRADE.state == "Accept" then
					TRADE.state = "Confirm"
					TRADE.confirmAt = time()
					if A:FindFirstChild("Confirm") then A.Confirm.Visible = true end
				end
			end))
		end
		local confirm = A:FindFirstChild("Confirm")
		if confirm and confirm:FindFirstChild("ActionButton") then
			table.insert(TRADE.conns, confirm.ActionButton.MouseButton1Click:Connect(function()
				if TRADE.cooldown <= 0 and TRADE.state == "Confirm" and time() - TRADE.confirmAt >= 0.4 then
					TRADE.state, TRADE.accepted = "Waiting", true
					pcall(function() tg.Container.Trade.YourOffer.Accepted.Visible = true end)
					if A:FindFirstChild("Cancel") then A.Cancel.Visible = true end
					acceptTrade()
				end
			end))
		end
		local cancel = A:FindFirstChild("Cancel")
		if cancel and cancel:FindFirstChild("ActionButton") then
			table.insert(TRADE.conns, cancel.ActionButton.MouseButton1Click:Connect(function()
				TRADE.accepted = false
				updateTrade()
			end))
		end
	end
	local decline = actions:FindFirstChild("Decline")
	if decline and decline:FindFirstChild("ActionButton") then
		table.insert(TRADE.conns, decline.ActionButton.MouseButton1Click:Connect(declineTrade))
	end
end

-- Rebuild the trade list from ProfileData (duped copies included) and
-- take over its clicks. Safe to call repeatedly.
local function startTrade(openIt)
	if TRADE.starting or not READY or not InventoryModule then return end
	local tg = tradeGui()
	if not tg then return end
	TRADE.starting = true
	-- One pcall around the whole rebuild, and `starting` is cleared on the
	-- way out no matter what. An earlier version cleared it only at the end,
	-- so the first throw in here latched the flag on and every later
	-- rebuild returned immediately — the trade list then kept showing the
	-- counts from whenever the trade opened, duped copies missing.
	local ok, err = pcall(function()
		for _, cat in pairs({"Weapons", "Pets"}) do
			local main = tg.Container.Items.Main:FindFirstChild(cat)
			local blank = InventoryModule.CreateBlankTradeInventoryTable()
			if main and blank and blank[cat] then
				for slot in pairs(blank[cat]) do
					local s = main.Items.Container:FindFirstChild(slot)
					if s and s:FindFirstChild("Container") then s.Container:ClearAllChildren() end
				end
			end
		end
		TRADE.inv = InventoryModule.GenerateInventory(tg.Container.Items, ProfileData, "Trading")
		setupConnections()
		updateTrade()
		if openIt and not tg.Enabled then tg.Enabled = true end
		if TRADE.searchConn then TRADE.searchConn:Disconnect() end
		local tabs = tg.Container.Items:FindFirstChild("Tabs")
		local search = tabs and tabs:FindFirstChild("Search")
		local st = search and search:FindFirstChild("Container")
		st = st and st:FindFirstChild("SearchText")
		if st then
			TRADE.searchConn = st:GetPropertyChangedSignal("Text"):Connect(function()
				local q = st.Text:lower()
				for _, byType in pairs(TRADE.inv.Data) do
					for _, group in pairs(byType) do
						for _, node in pairs(group) do
							if type(node) == "table" and node.Frame and node.Name then
								node.Frame.Visible = (q == "") or (tostring(node.Name):lower():find(q, 1, true) ~= nil)
							end
						end
					end
				end
			end)
		end
	end)
	TRADE.starting = false
	if not ok then warn("[Yomogi Dupe] trade rebuild failed: " .. tostring(err)) end
	return ok
end

--------------------------------------------------------------------
-- Their offer  (display only)
--
-- The trade window is TradeGUI.Container.Trade with a YourOffer and a
-- TheirOffer panel, each holding NewItem1..4. This fills the second one
-- exactly the way the spawner's trade module fills the first, so a few
-- seconds into a trade their side looks like they put something in.
--
-- YOUR SCREEN ONLY, and not in a way that has a workaround: the other
-- player's client builds its own trade view from what the server says
-- was actually offered, so nothing here reaches them and nothing here
-- can move an item. It changes what your screen looks like, full stop.
--------------------------------------------------------------------
local FAKE_OFFER = {
	Enabled = false,
	Delay   = 5.0,     -- seconds from the trigger to their items landing
	Accept  = true,    -- flip their "Accepted" tag a beat after the items land
	-- "offer" waits until YOU put something in, then answers it. "open"
	-- fires off the window opening instead. Answering your offer reads far
	-- better than items appearing into an empty trade.
	Trigger = "offer",
	-- With nothing loaded, fill their side with the most valuable weapons
	-- this game's DB actually has. Anything loaded by hand wins over it.
	Auto    = true,
	Key     = Enum.KeyCode.Y, -- arms/disarms; the dot by the close button follows it
	items   = {},      -- [1..4] = {cat, id, name, amount}
	token   = 0,       -- bumped to cancel anything still pending
	live    = false,   -- their side is currently showing something
}

-- Ranked by Supreme value, richest first, taken from MM2_InventoryValue's
-- VALUES table — C. Traveler's Gun 220k, Chroma Evergun 75k, Chroma
-- Evergreen 48k, Gingerscope 17.75k, and down from there.
--
-- Written as search strings rather than item ids on purpose: findItem
-- resolves them against whatever this game's DB actually calls things, so
-- an entry that no longer exists is skipped instead of rendering blank.
-- "C." is spelled out because the abbreviation is Supreme's, not MM2's.
--
-- Godly Batwing and Black Luger both list at 1,000,000 and are deliberately
-- NOT here — they are unobtainable one-offs, and any MM2 player reads one
-- in a trade window as fake on sight. These are the expensive items that
-- are still real items.
local RICH = {
	"Chroma Traveler's Gun", "Chroma Evergun", "Chroma Evergreen",
	"Gingerscope", "Chroma Bauble", "Chroma Constellation",
	"Chroma Vampire's Gun", "Chroma Alienbeam", "Traveler's Axe",
	"Chroma Raygun", "Chroma Sunrise", "Traveler's Gun",
	"Chroma Sunset", "Chroma Snowcannon", "Celestial", "Evergun",
}

-- findItem sweeps the whole DB per call, so resolve the list once and keep it
local richCache = nil
local function expensiveItems()
	if richCache then return richCache end
	richCache = {}
	local seen = {}
	for _, query in ipairs(RICH) do
		if #richCache >= 4 then break end
		local m = findItem(query)
		local key = m and (tostring(m.cat) .. ":" .. tostring(m.id))
		if m and not seen[key] then
			seen[key] = true
			table.insert(richCache, {cat = m.cat, id = m.id, name = m.name, amount = 1})
		end
	end
	return richCache
end

-- Named lookup first, then a structural sweep for the sibling panel that
-- also holds NewItem1 — so a rename in some future MM2 update degrades to
-- "finds it anyway" instead of "silently does nothing".
local function theirPanel()
	local tg = tradeGui()
	local trade = tg and tg.Container:FindFirstChild("Trade")
	if not trade then return nil end
	local named = trade:FindFirstChild("TheirOffer")
	if named and named:FindFirstChild("Container") then return named end
	local yours = trade:FindFirstChild("YourOffer")
	for _, child in ipairs(trade:GetChildren()) do
		if child ~= yours and child:IsA("GuiObject") then
			local c = child:FindFirstChild("Container")
			if c and c:FindFirstChild("NewItem1") then return child end
		end
	end
	return nil
end

-- What their side should show: the loaded list if you set one, otherwise
-- the four most valuable weapons this game has.
local function plannedItems()
	if #FAKE_OFFER.items > 0 then return FAKE_OFFER.items end
	if not FAKE_OFFER.Auto then return {} end
	return expensiveItems()
end

local function clearTheirOffer()
	FAKE_OFFER.token += 1 -- cancels any pending fill and stops the heartbeat
	FAKE_OFFER.live = false
	local panel = theirPanel()
	if not panel then return end
	pcall(function()
		for i = 1, 4 do
			local f = panel.Container:FindFirstChild("NewItem" .. i)
			if f then f.Visible = false end
		end
		if panel:FindFirstChild("Accepted") then panel.Accepted.Visible = false end
	end)
end

local function renderTheirOffer()
	local panel = theirPanel()
	if not panel or not ItemModule then return end
	local plan = plannedItems()
	pcall(function()
		for i = 1, 4 do
			local f = panel.Container:FindFirstChild("NewItem" .. i)
			local slot = plan[i]
			if f and slot then
				local info = itemInfo(slot.cat, slot.id)
				if info then
					local data = {}
					for k, v in pairs(info) do data[k] = v end
					data.DataType, data.Amount = slot.cat, slot.amount or 1
					data.ItemName, data.Name = slot.id, slot.id
					ItemModule.DisplayItem(f, data)
					f.Visible = true
				end
			elseif f then
				f.Visible = false
			end
		end
	end)
end

local function scheduleTheirOffer()
	if not FAKE_OFFER.Enabled or #plannedItems() == 0 then return end
	FAKE_OFFER.token += 1
	local t = FAKE_OFFER.token
	task.delay(FAKE_OFFER.Delay, function()
		if t ~= FAKE_OFFER.token then return end
		local tg = tradeGui()
		if not (tg and tg.Enabled) then return end
		renderTheirOffer()
		FAKE_OFFER.live = true
		-- The game repaints TheirOffer on every real trade update, which
		-- would blink our items straight back out — so hold it with a slow
		-- heartbeat rather than a single write. Same loop re-asserts the
		-- Accepted tag once its moment has passed.
		local acceptAt = FAKE_OFFER.Accept and (os.clock() + 1.6) or nil
		task.spawn(function()
			while t == FAKE_OFFER.token do
				local g = tradeGui()
				if not (g and g.Enabled) then break end
				renderTheirOffer()
				if acceptAt and os.clock() >= acceptAt then
					local panel = theirPanel()
					if panel and panel:FindFirstChild("Accepted") then
						pcall(function() panel.Accepted.Visible = true end)
					end
				end
				task.wait(0.8)
			end
		end)
	end)
end

-- Fires only when your offer's CONTENTS change — updateTrade also runs on
-- every rebuild and every accept-state flip, and re-answering all of those
-- would restart the countdown constantly.
local lastOfferSig = nil
local function offerSignature()
	local parts = {}
	for _, s in ipairs(TRADE.offer) do
		table.insert(parts, ("%s:%s:%d"):format(s.cat, tostring(s.id), s.amount or 1))
	end
	return table.concat(parts, "|")
end

onMyOfferChanged = function()
	local sig = offerSignature()
	if sig == lastOfferSig then return end
	lastOfferSig = sig
	if not FAKE_OFFER.Enabled or FAKE_OFFER.Trigger ~= "offer" then return end
	if sig == "" then
		clearTheirOffer() -- you pulled everything back out; their side goes too
		return
	end
	if FAKE_OFFER.live then
		-- already showing: adding a second item should update their side now,
		-- not blank it and make you wait out another five seconds
		renderTheirOffer()
	else
		scheduleTheirOffer()
	end
end

-- The open trigger is the other mode; skip it when we're answering offers.
local function scheduleOnOpen()
	if FAKE_OFFER.Trigger == "open" then scheduleTheirOffer() end
end

-- Take the trade over whenever one opens. The wait lets the game (and
-- the spawner's own trade module, if that is loaded too) finish building
-- first, so our rebuild is the one that ends up wired to the buttons.
pcall(function()
	local remotes = RS:FindFirstChild("Trade")
	if remotes and remotes:FindFirstChild("StartTrade") then
		remotes.StartTrade.OnClientEvent:Connect(function()
			task.wait(0.35)
			TRADE.offer = {}
			pcall(startTrade, false)
			pcall(scheduleOnOpen)
		end)
	end
end)

-- ...and catch the window opening any other way (or a trade that was
-- already up when the script was injected).
do
	local function bind(tg)
		if not tg then return end
		tg:GetPropertyChangedSignal("Enabled"):Connect(function()
			if tg.Enabled then
				task.wait(0.35)
				pcall(startTrade, false)
				pcall(scheduleOnOpen)
			else
				TRADE.offer = {}
				pcall(clearTheirOffer) -- also cancels a fill still counting down
			end
		end)
		if tg.Enabled then
			task.spawn(function()
				task.wait(0.25)
				pcall(startTrade, false)
				pcall(scheduleOnOpen)
			end)
		end
	end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		bind(pg:FindFirstChild("TradeGUI"))
		pg.ChildAdded:Connect(function(ch)
			if ch.Name == "TradeGUI" then
				task.wait(0.2)
				bind(ch)
			end
		end)
	end
end

local function refresh()
	pcall(function() RS.Remotes.Inventory.InventoryDataChanged:Fire() end)
	-- an open trade has to be rebuilt or it keeps showing the old counts
	pcall(function()
		local tg = tradeGui()
		if tg and tg.Enabled then startTrade(false) end
	end)
end

--------------------------------------------------------------------
-- The dupe itself: one click, one copy
--------------------------------------------------------------------
-- One copy into the owned table, remembered in Added so undo can take it
-- back out. Shared by the dupe button and by the items a faked trade
-- "hands you" on accept. Returns the new total, or nil + why not.
local function addOwned(cat, id)
	local owned = ownedTable(cat)
	if not owned then return nil, "no " .. cat:lower() .. " inventory in this game" end
	local count, form = ownedCount(cat, id)
	if count >= MAX_PER_ITEM then
		return nil, ("Already at the %d cap."):format(MAX_PER_ITEM)
	end
	if form == "array" then
		table.insert(owned, id)
	else
		owned[id] = count + 1
	end
	Added[cat] = Added[cat] or {}
	Added[cat][id] = (Added[cat][id] or 0) + 1
	return count + 1
end

-- The game's own received-item card — the one with the rarity bar and the
-- Claim button. Same signature the spawners use.
local function popupFor(cat, id)
	if not ItemPopupService then return end
	pcall(function() ItemPopupService.ItemReceived:Fire(id, cat) end)
end

local function dupeItem(cat, id)
	if not READY then return false, "inventory not readable in this game" end
	local total, err = addOwned(cat, id) -- already the NEW count, do not add 1
	if not total then return false, err end
	popupFor(cat, id)
	refresh()
	-- drop it straight into your offer if a trade is open, so duping
	-- during a trade fills the slot instead of needing a second click
	local placed = false
	if tradeGui() and tradeGui().Enabled then
		placed = offerItem(cat, id)
	end
	return true, nil, total, placed
end

local function undo()
	local removed = 0
	for cat, byId in pairs(Added) do
		local owned = ownedTable(cat)
		if owned then
			for id, n in pairs(byId) do
				if type(owned[id]) == "number" then
					local left = owned[id] - n
					if left > 0 then owned[id] = left else owned[id] = nil end
					removed += n
				else
					-- array form: drop our copies back-to-front so the
					-- indices we still have to visit don't shift
					local dropped = 0
					for i = #owned, 1, -1 do
						if dropped >= n then break end
						if owned[i] == id then
							table.remove(owned, i)
							dropped += 1
						end
					end
					removed += dropped
				end
			end
		end
	end
	Added = {}
	TRADE.offer = {}
	refresh()
	return removed
end

