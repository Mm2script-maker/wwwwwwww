-- Accepting a faked trade hands you what their side was showing: each item
-- lands in your inventory and raises the game's own received-item card, one
-- at a time so the cards don't stack on top of each other.
--
-- Assigned here rather than next to the rest of the their-offer code because
-- this is the first point in the file where logLine exists.
onTradeAccepted = function()
	if not (FAKE_OFFER.Enabled and FAKE_OFFER.live) then return end
	local received = {}
	for _, s in ipairs(plannedItems()) do
		table.insert(received, {cat = s.cat, id = s.id, name = s.name, amount = s.amount or 1})
	end
	if #received == 0 then return end
	task.spawn(function()
		task.wait(0.5) -- let the trade window finish closing first
		for _, s in ipairs(received) do
			for _ = 1, s.amount do addOwned(s.cat, s.id) end
			popupFor(s.cat, s.id)
			logLine(("received    %s"):format(s.name), THEME.Accent)
			task.wait(0.9)
		end
		refresh()
	end)
end

local function toggleFakeOffer()
	if #plannedItems() == 0 then
		logLine("offer       nothing to show in this game", THEME.Danger)
		return
	end
	FAKE_OFFER.Enabled = not FAKE_OFFER.Enabled
	syncOfferRow()
	if FAKE_OFFER.Enabled then
		logLine(("offer       armed  answers in %ds"):format(math.floor(FAKE_OFFER.Delay)), THEME.Accent)
		local tg = tradeGui()
		if tg and tg.Enabled then scheduleTheirOffer() end -- trade already up
	else
		clearTheirOffer()
		logLine("offer       disarmed")
	end
end

