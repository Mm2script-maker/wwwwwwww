	-- Progress fill: LIGHT, not dark. The button label sits above both the
	-- track and the fill sweeping under it, so on a light theme both have to
	-- stay light or the near-black label vanishes halfway across. It only
	-- goes dark at the end, in the same tween that flips the label to white.
	Fill     = Color3.fromRGB(176, 181, 189),
