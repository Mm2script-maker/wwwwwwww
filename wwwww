	busy = false           -- cleared BEFORE paintButton, which no-ops while busy
	paintButton(match ~= nil)
end

doDupe = function()
	if busy then return end
	if not READY then
		logLine("error       inventory module unreadable", THEME.Danger)
		return
	end
	if not match then
		logLine("error       type a weapon name first", THEME.Danger)
		return
	end

	local m = match -- pin it; the name box is still live during the run

	if not FAKE.Enabled then
		local ok, err, total, placed = commit(m)
		clearLog()
		if ok then
			logLine(("verify      ok  x%d"):format(total), THEME.Accent)
			logLine(placed and "offer       added to your trade" or "offer       open a trade to place it")
		else
			logLine("error       " .. tostring(err or "could not dupe that one"), THEME.Danger)
		end
		return
	end

	busy = true
	tween(dupeBtn, {BackgroundColor3 = THEME.Panel2})
	tween(dupeLabel, {TextColor3 = THEME.Text})
	tween(dupeStroke, {Transparency = 0.4})
	progFill.BackgroundColor3 = THEME.Fill
	progFill.Size = UDim2.new(0, 0, 1, 0)
	progEdge.Visible = true

	task.spawn(function()
		local span   = FAKE.MinSeconds + math.random() * (FAKE.MaxSeconds - FAKE.MinSeconds)
		local slot   = ("0x%04X"):format(math.random(0x1000, 0xFFFF))
		local hiccup = FAKE.HiccupOdds > 0 and math.random(1, FAKE.HiccupOdds) == 1

		-- percentage read straight off the bar, so the number and the fill
		-- can never disagree with each other
		local pct
		pct = RunService.RenderStepped:Connect(function()
			-- re-running the script mid-run destroys the GUI out from under
			-- this; drop the connection instead of ticking against a corpse
			if not dupeLabel.Parent then pct:Disconnect() return end
			dupeLabel.Text = ("DUPING  %d%%"):format(math.floor(progFill.Size.X.Scale * 100 + 0.5))
		end)

		clearLog()
		logLine(("target      %s  [%s]"):format(m.name, tostring(m.info.Rarity or "?")), THEME.Text)

		-- Uneven weights on purpose: a bar that advances in equal steps
		-- reads as a timer, which is exactly what it is. The slow stretch
		-- is the "clone", where the work would actually be.
		local plan = {
			{w = 0.8, p = 0.13, t = ("handshake   ok  node=%s  rtt=%dms"):format(NODE, math.random(18, 44))},
			{w = 1.2, p = 0.29, t = ("profile     read %d entries"):format(countEntries(m.cat))},
			{w = 1.7, p = 0.48, t = ("clone       %s -> %s"):format(m.name, slot)},
			{w = 1.5, p = 0.67, t = ("write       ProfileData.%s.Owned"):format(m.cat)},
			{w = 1.1, p = 0.86, t = "replicate   InventoryDataChanged"},
		}
		local wsum = 0
		for _, s in ipairs(plan) do wsum += s.w end

		for i, s in ipairs(plan) do
			local dur = span * (s.w / wsum)
			tween(progFill, {Size = UDim2.new(s.p, 0, 1, 0)}, dur)
			task.wait(dur)
			logLine(s.t)
			if hiccup and i == 4 then
				logLine("warn        429 rate limited, backing off", THEME.Accent2)
				task.wait(0.8 + math.random() * 0.7)
				logLine("retry       resending write")
				task.wait(0.45)
			end
		end

		local ok, err, total, placed = commit(m)

		tween(progFill, {Size = UDim2.new(1, 0, 1, 0)}, 0.22)
		task.wait(0.24)
		pct:Disconnect()
		progEdge.Visible = false

		if ok then
			logLine(("verify      ok  x%d"):format(total), THEME.Accent)
			logLine(placed and "offer       added to your trade" or "offer       open a trade to place it")
			dupeLabel.Text = "DUPED"
			tween(progFill, {BackgroundColor3 = THEME.Accent}, 0.12)
			tween(dupeLabel, {TextColor3 = THEME.OnAccent}, 0.12)
		else
			logLine("error       " .. tostring(err or "could not dupe that one"), THEME.Danger)
			dupeLabel.Text = "FAILED"
			tween(progFill, {BackgroundColor3 = THEME.Danger}, 0.12)
			-- the fill is full width by now, so the near-black label has to go
			-- white with it or it disappears into the red
			tween(dupeLabel, {TextColor3 = THEME.OnAccent}, 0.12)
		end

		task.wait(0.8)
		tween(progFill, {Size = UDim2.new(0, 0, 1, 0)}, 0.25)
		task.wait(0.26)
		resetButton()
	end)
end

