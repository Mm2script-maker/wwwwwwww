local logSeq = 0
local function logLine(text, color)
	logSeq += 1
	local lbl = mk("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = color or THEME.TextDim,
		TextTransparency = 1,
		TextSize = 11,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = logSeq,
	}, logList)
	tween(lbl, {TextTransparency = 0}, 0.18)

	local lines = {}
	for _, c in ipairs(logList:GetChildren()) do
		if c:IsA("TextLabel") then table.insert(lines, c) end
	end
	table.sort(lines, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	for i = 1, #lines - LOG_MAX do
		pcall(function() lines[i]:Destroy() end)
	end
	return lbl
end

local function clearLog()
	for _, c in ipairs(logList:GetChildren()) do
		if c:IsA("TextLabel") then c:Destroy() end
	end
end

