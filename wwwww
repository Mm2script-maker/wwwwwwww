--------------------------------------------------------------------
-- Parent the GUI. Parenting, not GetService, is what fails on limited
-- executors, so try each root and keep the first that actually sticks.
--------------------------------------------------------------------
do
	local parented = false
	for _, root in ipairs(guiRoots()) do
		local ok = pcall(function() dupeGui.Parent = root end)
		if ok and dupeGui.Parent == root then
			parented = true
			break
		end
	end
	if not parented then
		local pg = LocalPlayer:WaitForChild("PlayerGui", 10)
		if pg then pcall(function() dupeGui.Parent = pg end) end
	end
	if not dupeGui.Parent then
		error("[Yomogi Dupe] could not parent the GUI to gethui/CoreGui/PlayerGui")
	end
end

-- Only tears the window down. It deliberately does NOT undo: re-running
-- the script would otherwise wipe every copy you had just made.
-- Use _G.YomogiDupeUndo() (or rejoin) to put things back.
_G.YomogiDupeCleanup = function()
	pcall(clearTheirOffer) -- otherwise a re-run leaves ghost items in their panel
	pcall(function() dupeGui:Destroy() end)
end

-- Trade helpers. The engine takes the trade over on its own whenever one
-- opens, but these are handy from the console:
--   _G.YomogiTradeOpen()            -- rebuild the list / take it over now
--   _G.YomogiTradeOffer("frostbite")-- put one in your offer
--   _G.YomogiTradeClear()           -- empty your offer
_G.YomogiTradeOpen = function()
	startTrade(true)
	return TRADE.inv ~= nil
end
_G.YomogiTradeOffer = function(name)
	local m = findItem(name)
	if not m then return false, "not found" end
	return offerItem(m.cat, m.id), m.name
end
_G.YomogiTradeClear = function()
	TRADE.offer = {}
	updateTrade()
	return true
end

-- console helpers:  _G.YomogiDupe("snowcannon")  /  _G.YomogiDupeUndo()
-- Console dupes skip the run and land instantly — the show is for the
-- button, not for you.
_G.YomogiDupe = function(name)
	local m = findItem(name)
	if not m then return false, "not found" end
	local ok, err, total = commit(m)
	if nameBox.Text == "" then nameBox.Text = m.name end
	return ok, err or total
end

-- _G.YomogiDupeFast(true) drops the 5s run for the rest of the session
_G.YomogiDupeFast = function(on)
	FAKE.Enabled = not on
	return FAKE.Enabled
end

-- Their-offer helpers:
--   _G.YomogiFakeOffer("chroma seer", "chroma luger")  -- load + arm
--   _G.YomogiFakeOffer()                               -- clear + disarm
--   _G.YomogiFakeOfferNow()                            -- fill right now
--   _G.YomogiFakeOfferDelay(3)                         -- retime the wait
_G.YomogiFakeOffer = function(...)
	FAKE_OFFER.items = {}
	local missed = {}
	for _, n in ipairs({...}) do
		local m = findItem(n)
		if not m then
			table.insert(missed, tostring(n))
		elseif #FAKE_OFFER.items < 4 then
			table.insert(FAKE_OFFER.items, {cat = m.cat, id = m.id, name = m.name, amount = 1})
		end
	end
	FAKE_OFFER.Enabled = #FAKE_OFFER.items > 0
	if not FAKE_OFFER.Enabled then clearTheirOffer() end
	syncOfferRow()
	for _, n in ipairs(missed) do logLine("offer       no match for " .. n, THEME.Danger) end
	return #FAKE_OFFER.items
end

_G.YomogiFakeOfferNow = function()
	-- plannedItems, not items: with Auto on there IS something to show even
	-- when nothing was loaded by hand
	if #plannedItems() == 0 then return false, "nothing to show" end
	FAKE_OFFER.Enabled = true
	syncOfferRow()
	renderTheirOffer()
	FAKE_OFFER.live = true
	return true
end

_G.YomogiFakeOfferDelay = function(seconds)
	FAKE_OFFER.Delay = math.max(tonumber(seconds) or 5, 0)
	return FAKE_OFFER.Delay
end

-- auto off = their side only ever shows what _G.YomogiFakeOffer loaded
_G.YomogiFakeOfferAuto = function(on)
	FAKE_OFFER.Auto = (on ~= false)
	syncOfferRow()
	return FAKE_OFFER.Auto
end

-- raise the received-item card for one weapon on demand, without a trade
_G.YomogiPopup = function(name)
	local m = findItem(name)
	if not m then return false, "not found" end
	popupFor(m.cat, m.id)
	return true, m.name
end

-- what the auto pick resolved to in this game, richest first
_G.YomogiFakeOfferList = function()
	local names = {}
	for _, s in ipairs(expensiveItems()) do table.insert(names, s.name) end
	return table.concat(names, ", ")
end

-- "offer" answers your offer, "open" fires off the window opening
_G.YomogiFakeOfferTrigger = function(mode)
	mode = tostring(mode or ""):lower()
	if mode ~= "offer" and mode ~= "open" then return false, 'use "offer" or "open"' end
	FAKE_OFFER.Trigger = mode
	return mode
end
_G.YomogiDupeUndo = function()
	local removed = undo()
	if match then showMatch(match) end
	return removed
end

