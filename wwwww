-- What actually happens, with none of the show around it. Split out so
-- the console helpers can still dupe instantly.
local function commit(m)
	local ok, err, total, placed = dupeItem(m.cat, m.id)
	if ok then
		session += 1
		sessionPill.Text = "+" .. session
		sessionPill.Visible = true
		pushRecent(m)
		-- only repaint the card if the box still shows this item; the run
		-- takes ~5s and the name can have been retyped in the meantime
		if match and match.id == m.id and match.cat == m.cat then showMatch(m) end
	end
	return ok, err, total, placed
end

local function resetButton()
	progEdge.Visible = false
	progFill.Size = UDim2.new(0, 0, 1, 0)
	progFill.BackgroundColor3 = THEME.Fill
