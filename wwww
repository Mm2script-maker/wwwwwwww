local function make(cls, props, kids)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	return o
end
local function round(p, r) make("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = p }) end
local function stroke(p, col, th) make("UIStroke", { Color = col or BORDER, Thickness = th or 1, Parent = p }) end
local function tween(obj, props) TweenService:Create(obj, TI_FAST, props):Play() end

