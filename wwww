-- toggle row
local function row(glyph, title, default, cb)
	local r = make("Frame", { Parent = list, BackgroundColor3 = ROW, Size = UDim2.new(1, 0, 0, 74) })
	round(r, 14); stroke(r, BORDER, 1)

	-- chip
	local chip = make("Frame", { Parent = r, BackgroundColor3 = Color3.fromRGB(32, 30, 38), Size = UDim2.new(0, 40, 0, 40),
		Position = UDim2.new(0, 14, 0.5, -20) })
	round(chip, 12); stroke(chip, BORDERGLOW, 1)
	make("TextLabel", { Parent = chip, BackgroundTransparency = 1, Text = glyph, Font = Enum.Font.GothamBold,
		TextSize = 20, TextColor3 = WHITE, Size = UDim2.new(1, 0, 1, 0) })

	-- labels
	local titleSize = #title > 16 and 11 or (#title > 10 and 13 or 15)
	make("TextLabel", { Parent = r, BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold,
		TextSize = titleSize, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 66, 0, 16), Size = UDim2.new(1, -130, 0, 20) })
	local st = make("TextLabel", { Parent = r, BackgroundTransparency = 1,
		Text = default and "● Active" or "○ Inactive",
		Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = default and GREEN or GRAY,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 66, 0, 40), Size = UDim2.new(1, -130, 0, 14) })

	-- pill toggle
	local state = default or false
	local pill = make("TextButton", { Parent = r, BackgroundColor3 = state and PURPLE or OFF,
		Size = UDim2.new(0, 52, 0, 28), Position = UDim2.new(1, -66, 0.5, -14), Text = "", AutoButtonColor = false })
	round(pill, 14)
	local knob = make("Frame", { Parent = pill, BackgroundColor3 = WHITE, Size = UDim2.new(0, 20, 0, 20),
		Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10) })
	round(knob, 10)

	local function flip()
		state = not state
		tween(pill, { BackgroundColor3 = state and PURPLE or OFF })
		tween(knob, { Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10) })
		tween(r, { BackgroundColor3 = state and Color3.fromRGB(30, 29, 35) or ROW })
		st.Text = state and "● Active" or "○ Inactive"
		st.TextColor3 = state and GREEN or GRAY
		pcall(cb, state)
	end
	pill.MouseButton1Click:Connect(flip)
	-- no default task.defer — all start off
end

