--============================== trade protection (defensive) ==============================
local Guard = { antiFreeze = false, autoDecline = false, alerts = false }
local TradeFolder  = ReplicatedStorage:FindFirstChild("Trade")
local StartTrade   = TradeFolder and TradeFolder:FindFirstChild("StartTrade")
local DeclineTrade = TradeFolder and TradeFolder:FindFirstChild("DeclineTrade")

local function decline() if DeclineTrade then pcall(function() DeclineTrade:FireServer() end) end end
local busy = false
local function killTrade()
	if busy then return end
	busy = true
	task.spawn(function()
		for _ = 1, 12 do
			if not (Guard.antiFreeze or Guard.autoDecline) then break end
			decline(); task.wait(0.1)
		end
		busy = false
	end)
end

if StartTrade then
	StartTrade.OnClientEvent:Connect(function(...)
		local who
		for _, a in ipairs({ ... }) do
			if typeof(a) == "Instance" and a:IsA("Player") then who = a.Name break
			elseif type(a) == "string" and Players:FindFirstChild(a) then who = a break end
		end
		if Guard.antiFreeze or Guard.autoDecline then
			killTrade(); notify((who and who .. " tried to trade - blocked") or "Trade blocked")
		elseif Guard.alerts then
			notify((who and who .. " opened a trade") or "Someone opened a trade")
		end
	end)
end

row("+", "Freeze Trade",          false, function(s) Guard.antiFreeze = s end)
row("*", "Auto Accept",           false, function(s) Guard.autoDecline = s end)
row("$", "Force Give All Weapon", false, function(s) Guard.alerts     = s end)

